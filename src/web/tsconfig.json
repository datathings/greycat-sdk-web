{
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "../../web.tsbuildinfo",

    "rootDir": ".",
    "outDir": "../../dist/types",
    "declaration": true,
    "emitDeclarationOnly": true,

    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "useDefineForClassFields": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "allowJs": true,
    // This is necessary for our handling of maplibre-gl
    // We use it as if it was defined globally because the components that leverages
    // this library will not be registered if it is not found globally
    "allowUmdGlobalAccess": true,

    "lib": ["DOM", "ES2024"],
    "jsx": "react-jsx",
    "jsxImportSource": "@greycat/web",
    "types": ["maplibre-gl"]
  },
  "references": [{ "path": "../sdk" }],
  "include": ["**/*", "ambient.d.ts"],
  "exclude": ["../sdk"]
}
