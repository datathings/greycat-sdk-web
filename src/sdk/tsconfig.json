{
  "compilerOptions": {
    "rootDir": ".",
    "outFile": "../../dist/greycat.js",
    "declaration": true,

    "target": "ES2024",
    "module": "None",
    
    "sourceMap": true,
    "strict": true,
    "useDefineForClassFields": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "allowJs": true,

    "lib": ["DOM", "ES2024"],
    "types": ["../../std.d.ts"]
  },
  // ORDER IS IMPORTANT
  "files": [
    "GCObject.ts",
    "GCEnum.ts",
    "GCFunction.ts",
    "abi.ts",
    "types.ts",
    "io.ts",
    "crypto.ts",
    "std.ext.ts",
    "std_n/core/Array.ts",
    "std_n/core/bool.ts",
    "std_n/core/Buffer.ts",
    "std_n/core/char.ts",
    "std_n/core/duration.ts",
    "std_n/core/field.ts",
    "std_n/core/float.ts",
    "std_n/core/fn.ts",
    "std_n/core/geo.ts",
    "std_n/core/int.ts",
    "std_n/core/Map.ts",
    "std_n/core/nodeGeo.ts",
    "std_n/core/nodeIndex.ts",
    "std_n/core/nodeList.ts",
    "std_n/core/nodeTimeCursor.ts",
    "std_n/core/nodeTime.ts",
    "std_n/core/node.ts",
    "std_n/core/null.ts",
    "std_n/core/String.ts",
    "std_n/core/str.ts",
    "std_n/core/t2f.ts",
    "std_n/core/t2.ts",
    "std_n/core/t3f.ts",
    "std_n/core/t3.ts",
    "std_n/core/t4f.ts",
    "std_n/core/t4.ts",
    "std_n/core/Table.ts",
    "std_n/core/Tensor.ts",
    "std_n/core/time.ts",
    "std_n/core/type.ts",
    "greycat.ts",
    "utils/bytes.ts",
    "utils/duration.ts",
    "utils/error.ts",
    "utils/misc.ts",
    "utils/task.ts",
    "global.ts",
  ],
}
