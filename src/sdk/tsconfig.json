{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../dist/sdk/lib",
    "declaration": true,
    "skipLibCheck": true,

    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "sourceMap": true,
    "strict": true,
    "useDefineForClassFields": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,

    "lib": ["DOM", "ES2024"],
    // This empty array IS important to prevent TypeScript
    // from including all the .d.ts files it finds in the
    // common resolution directories (node_modules, etc.)
    "types": []
  },
  "files": ["../../std.d.ts", "../../std.ext.d.ts", "_global.d.ts"],
  "include": ["**/*.ts"]
}
