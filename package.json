{
  "name": "@greycat/web",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "assets",
    "dist",
    "skills",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/sdk/index.js",
    "./dist/sdk/lib/global.js",
    "./dist/sdk/lib/polyfill.js",
    "./dist/web/index.js",
    "./dist/web/init.js",
    "./dist/web/extensions.js",
    "./dist/web/shoelace.js",
    "./dist/web/components/common.js",
    "./dist/web/components/all.js",
    "./dist/web/components/*/register.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./greycat.wasm": "./dist/greycat.wasm",
    "./jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.js"
    },
    "./shoelace.js": {
      "types": "./dist/web/shoelace.d.ts",
      "import": "./dist/web/shoelace.js"
    },
    "./components/*.js": {
      "types": "./dist/web/components/*.d.ts",
      "import": "./dist/web/components/*.js"
    },
    "./components/*": {
      "types": "./dist/web/components/*/register.d.ts",
      "import": "./dist/web/components/*/register.js"
    },
    "./*.css": "./dist/*.css",
    "./assets/*.svg": "./assets/*.svg"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "gen": "greycat install && GREYCAT_CORE=1 ./bin/greycat codegen ts && mv project.d.ts std.d.ts",
    "gen:test": "./bin/greycat codegen ts && mv project.d.ts test/project.d.ts",
    "build": "node scripts/build.js",
    "build:jsx": "node scripts/build.js jsx",
    "build:sdk": "node scripts/build.js sdk",
    "build:web": "node scripts/build.js web",
    "build:vite-plugin": "node scripts/build.js vite-plugin",
    "build:css": "node scripts/build.js css",
    "prepare:test": "./test/prepare.sh",
    "test": "./test/run.sh",
    "lint": "oxlint",
    "fmt": "oxfmt \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "@types/d3": "7.4.3"
  },
  "devDependencies": {
    "@shoelace-style/shoelace": "2.20.1",
    "@types/node": "24.19.2",
    "@typescript/typescript6": "6.0.2",
    "d3": "7.9.0",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "lightningcss-cli": "1.33.0",
    "maplibre-gl": "6.15.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rollup": "4.64.12",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "@shoelace-style/shoelace": ">=2.7.0 <3",
    "d3": ">=7.0.0 <8",
    "echarts": ">=6.0.0 <7",
    "maplibre-gl": ">=5.0.0 <7"
  },
  "packageManager": "pnpm@11.9.0"
}
