{
  "name": "@greycat/web",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/greycat.web.esm.js"
    },
    "./sdk": {
      "types": "./dist/greycat.d.ts",
      "import": "./dist/greycat.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*.ttf": "./fonts/*.ttf",
    "./*.woff": "./fonts/*.woff",
    "./icons/*.svg": "./icons/*.svg"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "fonts",
    "icons",
    "src",
    "css"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "gen": "GREYCAT_CODEGEN_TS_STD=1 GREYCAT_CODEGEN_TS_FOOTER=std.ext.d.ts greycat codegen . && mv project.d.ts std.d.ts",
    "build": "pnpm build:jsx && pnpm build:sdk && pnpm build:web && pnpm build:vite-plugin && pnpm build:css",
    "build:jsx": "tsc -p src/jsx/tsconfig.json",
    "build:sdk": "tsc -p src/sdk/tsconfig.json && cat std.d.ts >> dist/greycat.d.ts",
    "build:web": "tsc -p src/web/tsconfig.json && node esbuild.config.js",
    "build:vite-plugin": "tsc -p src/vite-plugin/tsconfig.json",
    "build:css": "lightningcss --minify --bundle --targets '>=0.25%' css/greycat.css -o dist/greycat.css",
    "build:playground": "tsc -p playground/tsconfig.json && vite build -c playground/vite.config.ts",
    "prepare:test": "./test/prepare-test.sh",
    "test": "./test/test.sh",
    "dev": "vite -c playground/vite.config.ts",
    "lint": "eslint src  --max-warnings 0 --ext .js,.jsx,.ts,.tsx",
    "fmt": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "@shoelace-style/shoelace": "2.19.0",
    "d3": "7.8.5",
    "dockview-core": "1.10.1",
    "lit-html": "3.2.1"
  },
  "devDependencies": {
    "@tabler/icons": "2.47.0",
    "@types/d3": "7.4.0",
    "@types/http-proxy": "1.17.15",
    "@types/node": "22.5.0",
    "@typescript-eslint/eslint-plugin": "6.2.1",
    "esbuild": "0.24.2",
    "eslint": "8.46.0",
    "lightningcss": "1.25.1",
    "lightningcss-cli": "1.25.1",
    "prettier": "3.3.3",
    "tslib": "2.6.3",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  },
  "optionalDependencies": {
    "http-proxy": "1.18.1"
  }
}