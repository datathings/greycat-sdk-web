{
  "name": "@greycat/web",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "assets",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/sdk/index.js",
    "./dist/sdk/lib/global.js",
    "./dist/sdk/lib/polyfill.js",
    "./dist/web/index.js",
    "./dist/web/init.js",
    "./dist/web/extensions.js",
    "./dist/web/shoelace.js",
    "./dist/web/components/common.js",
    "./dist/web/components/all.js",
    "./dist/web/components/*/register.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./greycat.wasm": "./dist/greycat.wasm",
    "./jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.js"
    },
    "./shoelace.js": {
      "types": "./dist/web/shoelace.d.ts",
      "import": "./dist/web/shoelace.js"
    },
    "./components/*.js": {
      "types": "./dist/web/components/*.d.ts",
      "import": "./dist/web/components/*.js"
    },
    "./components/*": {
      "types": "./dist/web/components/*/register.d.ts",
      "import": "./dist/web/components/*/register.js"
    },
    "./*.css": "./dist/*.css",
    "./assets/*.svg": "./assets/*.svg"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "gen": "greycat install && rm lib/installed && GREYCAT_TARGET=wasm32 greycat install && GREYCAT_CORE=1 ./bin/greycat codegen ts && mv project.d.ts std.d.ts",
    "build": "pnpm build:jsx && pnpm build:sdk && pnpm build:web && pnpm build:vite-plugin && pnpm build:css",
    "build:jsx": "tsc -p src/jsx/tsconfig.json",
    "build:sdk": "node scripts/gen-wasm.js && rm -rf dist/sdk && tsc -p src/sdk/tsconfig.json && node scripts/build-dts.js",
    "build:web": "rm -rf dist/web && tsc -p src/web/tsconfig.json && rollup -c rollup.web.js",
    "build:vite-plugin": "tsc -p src/vite-plugin/tsconfig.json",
    "build:css": "pnpm run build:css:greycat && pnpm run build:css:greycat-full",
    "build:css:greycat": "lightningcss --minify --bundle --targets '>=0.25%' css/greycat.css -o dist/greycat.css",
    "build:css:greycat-full": "lightningcss --minify --bundle --targets '>=0.25%' css/greycat-full.css -o dist/greycat-full.css",
    "build:playground": "tsc -p playground/tsconfig.json && vite build -c playground/vite.config.ts",
    "prepare:test": "./test/prepare.sh",
    "test": "./test/run.sh",
    "dev": "vite -c playground/vite.config.ts",
    "lint": "oxlint -c oxlint.json",
    "fmt": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "@types/d3": "7.4.3"
  },
  "devDependencies": {
    "@shoelace-style/shoelace": "2.20.1",
    "@tabler/icons": "2.47.0",
    "@types/node": "24.9.2",
    "d3": "7.9.0",
    "dockview-core": "3.2.0",
    "echarts": "6.0.0",
    "esbuild": "0.27.2",
    "lightningcss": "1.31.0",
    "lightningcss-cli": "1.31.0",
    "maplibre-gl": "5.16.0",
    "oxfmt": "0.26.0",
    "oxlint": "1.72.0",
    "rollup": "4.55.2",
    "rollup-plugin-dts": "6.3.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "7.3.1"
  },
  "peerDependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "d3": "^7.9.0",
    "dockview-core": "^3.2.0",
    "echarts": "^6.0.0",
    "maplibre-gl": "^5.16.0"
  },
  "packageManager": "pnpm@11.9.0"
}
