{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["test/playground", "dist"],
  "rules": {
    "no-unused-vars": "warn",
    "no-new-array": "allow",
    "@typescript-eslint/no-explicit-any": "warn"
  },
  "overrides": [{ "files": ["src/sdk/**"], "rules": { "no-unused-vars": "off" } }]
}
