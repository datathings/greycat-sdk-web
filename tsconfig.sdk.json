{
  "compilerOptions": {
    "outDir": "dist/sdk",
    "rootDir": "src/sdk",

    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "useDefineForClassFields": false,
    "sourceMap": true,
    "declaration": true,

    "strict": true,
    "allowJs": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,

    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "@greycat/web",
    "types": []
  },
  "include": ["src/sdk"],
  "exclude": ["node_modules"]
}
