{
  "compilerOptions": {
    "outDir": "dist/sdk",
    "rootDir": "src/sdk",

    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "useDefineForClassFields": false,
    "sourceMap": true,
    "declaration": true,

    "strict": true,
    "allowJs": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,

    "lib": ["DOM", "ES2024"],
    "types": []
  },
  "include": ["src/sdk"],
  "exclude": ["node_modules", "dist"]
}
