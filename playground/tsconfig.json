{
  "extends": "../src/web/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@greycat/web",
    "useDefineForClassFields": false,
    "lib": ["DOM", "ES2024"],
    "types": ["vite/client"],
    "paths": {
      "~/*": ["./*"],
      "@greycat/web/jsx-dev-runtime": ["../src/jsx/jsx-runtime.ts"],
      "@greycat/web/jsx-runtime": ["../src/jsx/jsx-runtime.ts"],
      "@greycat/web/sdk": ["../dist/sdk/index.d.ts"],
      "@greycat/web/wasm": ["../dist/wasm/index.d.ts"],
      "@greycat/web/components/*": ["../src/web/components/*"],
      "@greycat/web": ["../src/web"]
    }
  },
  "include": ["project.d.ts", "./**/*.ts", "./**/*.tsx", "../src/web", "../src/jsx"],
  "exclude": ["./gcdata", "./files", "./public", "vite.config.ts"]
}
