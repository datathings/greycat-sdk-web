@expose
fn complex_object() {
    var map = Map<String, any> {};
    map.set("first", ("BAR", 42));
    map.set("second", TimeZone::"Africa/Abidjan");

    var array = [42, 3.14, "hello world"];
    for (var i = 0; i < 100; i++) {
        array.add(i);
    }

    return ComplexObject {
        string: "Hello, world!",
        int: 42,
        float: 3.14,
        bool: false,
        char: 'd',
        geo: geo { 1.4, -0.85 },
        null: null,
        enum: TimeZone::"Europe/Paris",
        array: array,
        nodeTime: nodeTime {},
        nodeIndex: nodeIndex {},
        nodeList: nodeList {},
        nodeGeo: nodeGeo {},
        date: time::now().toDate(null),
        tuple: Tuple<String, String> { x: "This is", y: "a tuple" },
        nested: ComplexObject {
            string: "Hello, world!",
            int: 42,
            float: 3.14,
            bool: false,
            char: 'd',
            geo: geo { 1.4, -0.85 },
            map: Map<String, any> {},
            tuple: Tuple<int, int> { x: 1337, y: 42 },
            null: null,
            array: [42, 3.14, "hello world"],
            nodeTime: nodeTime {},
            nodeIndex: nodeIndex {},
            nodeList: nodeList {},
            nodeGeo: nodeGeo {},
            enum: TimeZone::"Europe/Luxembourg",
            date: time::now().toDate(null),
        },
        map: map,
    };
}

