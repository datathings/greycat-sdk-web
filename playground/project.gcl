@expose
fn complex_object() {
  var map = Map<String, any> {};
  map.set("first",("BAR", 42));
  map.set("second", TimeZone::"Africa/Abidjan");

  var array = [42, 3.14, "hello world"];
  for (var i = 0; i < 100; i++) {
    array.add(i);
  }

  return ComplexObject {
    string: "Hello, world!",
    int: 42,
    float: 3.14,
    bool: false,
    char: 'd',
    geo: geo { 1.4, -0.85 },
    null: null,
    enum: TimeZone::"Europe/Paris",
    array: array,
    nodeTime: nodeTime {},
    nodeIndex: nodeIndex {},
    nodeList: nodeList {},
    nodeGeo: nodeGeo {},
    t2: t2 {1, 2},
    t2f: t2f {1.42, 2.42},
    t3: t3 {1, 2, 3},
    t3f: t3f {1.42, 2.42, 3.42},
    t4: t4 {1, 2, 3, 4},
    t4f: t4f {1.42, 2.42, 3.42, 4.42},
    str: str { "hello" },
    date: time::now().toDate(null),
    tuple: Tuple<String, String> { x: "This is", y: "a tuple" },
    nested: ComplexObject {
      string: "Hello, world!",
      int: 42,
      float: 3.14,
      bool: false,
      char: 'd',
      geo: geo { 1.4, -0.85 },
      map: Map<String, any> {},
      tuple: Tuple<int, int> { x: 1337, y: 42 },
      null: null,
      array: [42, 3.14, "hello world"],
      nodeTime: nodeTime {},
      nodeIndex: nodeIndex {},
      nodeList: nodeList {},
      nodeGeo: nodeGeo {},
      enum: TimeZone::"Europe/Luxembourg",
      t2: t2 {1, 2},
      t2f: t2f {1.42, 2.42},
      t3: t3 {1, 2, 3},
      t3f: t3f {1.42, 2.42, 3.42},
      t4: t4 {1, 2, 3, 4},
      t4f: t4f {1.42, 2.42, 3.42, 4.42},
      str: str { "hello" },
      date: time::now().toDate(null),
    },
    map: map,
  };
}

