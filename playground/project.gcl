fn init_float() {
    serie_float ?= nodeTime<float> {};

    var now = time::now();
    var start = now.calendar_add(-1, CalendarUnit::year, TimeZone::"Europe/Paris");

    var random = Random {};
    var curr = start;
    var prev = 0_f;
    while (curr < now) {
        var value = nextValueFloat(prev, random, 0.05);
        serie_float.setAt(curr, value);
        prev = value;
        curr = curr.calendar_add(1, CalendarUnit::minute, TimeZone::"Europe/Paris");
    }
}

fn init_kline() {
    kline = nodeTime<KLine> {};

    var now = time::now();
    var start = now.calendar_add(-1, CalendarUnit::month, TimeZone::"Europe/Paris");

    var random = Random {};
    var curr = start;
    var open = 2.5_f;
    var close = 2.5_f;
    var volume = 0;
    while (curr < now) {
        kline.setAt(curr, KLine { open: open, close: close, volume: volume });
        open = nextValueFloat(open, random, 0.05);
        close = nextValueFloat(close, random, 0.05);
        volume = nextValueInt(volume, random, 10_000);
        curr = curr.calendar_add(1, CalendarUnit::day, TimeZone::"Europe/Paris");
    }
}

fn nextValueFloat(prev: float, random: Random, threshold: float): float {
    var throttle = random.uniformf(-threshold, threshold);
    if (prev - throttle > 0) {
        return prev - throttle;
    }
    return prev + throttle;
}

fn nextValueInt(prev: int, random: Random, threshold: int): int {
    var throttle = random.uniform(-threshold, threshold);
    if (prev - throttle > 0) {
        return prev - throttle;
    }
    return prev + throttle;
}

@expose
fn serie_of_obj() {
    if (kline.size() == 0) {
        return Table {};
    }
    return nodeTime::sample(Array<nodeTime> { kline }, null, null, 1000, SamplingMode::adaptative, null, null);
}

var huge_table: node<Table?>;

@expose
fn sample_huge_csv(): Table? {
    var table = *huge_table;
    if (table != null) {
        info("load from cache");
        return table;
    }
    info("sampling...");
    var reader = CsvReader {
        path: "files/people-10000.csv",
        format: CsvFormat {
            header_lines: 1,
        },
    };
    huge_table.set(Csv::sample(reader, null));
    info("updated cache");
    return *huge_table;
}

@expose
fn destructuring_table(): Table {
    var table = Table {};
    table.set_cell(0, 0, Person { name: "John", age: 42, activated: true });
    table.set_cell(1, 0, Person { name: "Paul", age: 36, activated: false });
    table.set_cell(2, 0, Person { name: "Maria", age: 27, activated: true });
    return table;
}

