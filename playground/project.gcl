@expose
fn task_long_running() {
    Task::expected_steps(60);
    for (var i = 0; i < 60; i++) {
        Task::add_steps(1);
        Runtime::sleep(1_s);
    }
}

@expose
fn task_long_running2() {
    Task::expected_steps(60);
    for (var i = 0; i < 60; i++) {
        Task::add_steps(1);
        Runtime::sleep(1_s);
    }
}

@expose
fn controlled_task(duration: duration) {
    var steps = 100;
    Task::expected_steps(steps);
    var sleep = duration::new(duration.to(DurationUnit::milliseconds) / steps, DurationUnit::milliseconds);
    for (var i = 0; i < steps; i++) {
        Task::add_steps(1);
        Runtime::sleep(sleep);
    }
}

