type Node {
    id: String;
    value: any;
    link: node<Node>?;
}

@expose
fn tree() {
    var root = node<Node> { Node { id: "root", value: 0 } };
    var node0 = node<Node> { Node { id: "node_0", value: 42 } };
    var node1 = node<Node> { Node { id: "node_1", value: 1337 } };
    root->link = node0;
    node0->link = node1;
    node1->link = root;
    return root;
}

