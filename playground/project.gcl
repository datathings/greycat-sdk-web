fn main() {
    Identity::set_password("root", "root");

    Identity::create("leiko", "user");
    Identity::create("thols", "user");
    Identity::create("daroth", "user");
    Identity::create("tashack", "user");
    Identity::create("thargone", "user");
    for (var i = 0; i < 100; i++) {
        Identity::create("user${i}", "user");
    }

    cities::import();
    init_non_overlapping();

    if (serie_float.size() == 0) {
        init_float();
    }

    if (kline.size() == 0) {
        init_kline();
    }

    init_simple_index();
    node_time::init_node_time();
    heatmap::init();

    Identity::create("users", "user");
    Identity::create("moderators", "user");
    Identity::create("reviewers", "user");

    random_data.set(0, nodeList<float> {});
    random_data.set(1, nodeList<float> {});
    random_data.set(2, nodeList<float> {});

    Scheduler::add(fn () { insert_random_data(0, 10_000); }, FixedPeriodicity { every: 5s }, null);
    Scheduler::add(fn () { insert_random_data(1, 1000); }, FixedPeriodicity { every: 2s }, null);
    Scheduler::add(fn () { insert_random_data(2, 40_000); }, FixedPeriodicity { every: 5s }, null);
}

fn insert_random_data(id: int, nb: int) {
    var rng = Random {};
    var list = random_data.get(id);
    if (list == null) {
        return;
    }

    for (var i = 0; i < nb; i++) {
        list.add(rng.uniformf(0.0, 1.0));
    }
}

