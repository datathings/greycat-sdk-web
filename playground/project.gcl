fn init_non_overlapping() {
  if (non_overlapping_1.size() == 0) {
    var t1 = time::parse("01/01/2020", "%d/%M/%Y");
    var t2 = time::parse("02/01/2020", "%d/%M/%Y");
    var t3 = time::parse("03/01/2020", "%d/%M/%Y");
    var t4 = time::parse("04/01/2020", "%d/%M/%Y");

    var i = 0;
    for (var t = t1; t < t2; t = t + 1_hour) {
      non_overlapping_1.setAt(t, 10.0 + i * 0.01);
      i = i + 1;
    }

    i = 0;
    for (var t = t2; t < t3; t = t + 1_hour) {
      non_overlapping_2.setAt(t, 15.0 - i * 0.01);
      i = i + 1;
    }

    i = 0;
    for (var t = t3; t < t4; t = t + 1_hour) {
      non_overlapping_3.setAt(t, 20.0 + i * 0.02);
      i = i + 1;
    }
  }
}

@volatile
private type TimeRecord<T> {
  time: time;
  value: T;
}

type Composed {
  a: int;
  b: float;
}

@expose
fn table_of_objects(): Table<TimeRecord<Composed>> {
  var table = Table<TimeRecord<Composed>> {};

  var start = time::now();

  table.set_row(0, TimeRecord<Composed> { time: start, value: Composed { a: 1, b: 0.1 } });
  table.set_row(1, TimeRecord<Composed> { time: start + 1hour, value: Composed { a: 2, b: 0.2 } });
  table.set_row(2, TimeRecord<Composed> { time: start + 2hour, value: Composed { a: 3, b: 0.3 } });
  table.set_row(3, TimeRecord<Composed> { time: start + 3hour, value: Composed { a: 4, b: 0.4 } });

  for (var i = 0; i < table.rows(); i++) {
    println(table.get_row(i));
  }

  return table;
}

@volatile
private type TimedComposed {
  time: time;
  a: int;
  b: float;
}

@expose
fn table_of_objects2(): Table<TimedComposed> {
  var table = Table<TimedComposed> {};

  var start = time::now();

  table.set_row(0, TimedComposed { time: start, a: 1, b: 0.1 });
  table.set_row(1, TimedComposed { time: start + 1hour, a: 2, b: 0.2 });
  table.set_row(2, TimedComposed { time: start + 2hour, a: 3, b: 0.3 });
  table.set_row(3, TimedComposed { time: start + 3hour, a: 4, b: 0.4 });
  // pprint(table);

  return table;
}

// pages/histogram
@expose
fn one_d_histogram_bins(): Array<HistogramBin<float>>
{
  var csvFormat = CsvFormat {};
  csvFormat.separator = ',';
  csvFormat.header_lines = 1;
  var csv = CsvReader<Array<float>> { path: "pages/histogram/heightweight.csv", format: csvFormat };
  var gaus = Gaussian<float> {};
  while (csv.can_read()) {
    var res = csv.read();
    var height_inch = res[1];
    var height_cm = height_inch * 2.54;
    gaus.add(height_cm);
  }
  csv = CsvReader<Array<float>> { path: "pages/histogram/heightweight.csv", format: csvFormat };
  var histogramHeight = Histogram<float> { quantizer: LinearQuantizer<float> {bins: 10, min: gaus.min ?? 0.0, max: gaus.max ?? 1.0 } };
  while (csv.can_read()) {
    var res = csv.read();
    var height_inch = res[1];
    var height_cm = height_inch * 2.54;
    histogramHeight.add(height_cm);
  }

  return histogramHeight.get_bins();
}

@expose
fn histogram_stats(): HistogramStats<float>?
{
  var csvFormat = CsvFormat {};
  csvFormat.separator = ',';
  csvFormat.header_lines = 1;
  var csv = CsvReader<Array<float>> { path: "pages/histogram/heightweight.csv", format: csvFormat };
  var gaus = Gaussian<float> {};
  while (csv.can_read()) {
    var res = csv.read();
    var height_inch = res[1];
    var height_cm = height_inch * 2.54;
    gaus.add(height_cm);
  }
  csv = CsvReader<Array<float>> { path: "pages/histogram/heightweight.csv", format: csvFormat };
  var histogramHeight = Histogram<float> { quantizer: LinearQuantizer<float> {bins: 10, min: gaus.min ?? 0.0, max: gaus.max ?? 1.0 } };
  while (csv.can_read()) {
    var res = csv.read();
    var height_inch = res[1];
    var height_cm = height_inch * 2.54;
    histogramHeight.add(height_cm);
  }

  return histogramHeight.stats();
}


