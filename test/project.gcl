@library("std", "8.0.291-dev");

// Each round-trip fixture is written to its own file fixtures/<idx>.gcb so that
// tests can deserialize them independently. A node<int?> counter is required
// because module-level vars must be nodes in greycat.
var w_idx: node<int?>;

type Person {
    name: String;
    age: int;
    nickname: String?;
}

type Box<T> {
    value: T;
}

enum Color {
    red;
    green;
    blue;
}

fn main() {
    write_fixtures();
}

fn w(value: any?) {
    var i = *w_idx ?? 0;
    GcbWriter { path: "fixtures/${i}.gcb" }.write(value);
    w_idx.set(i + 1);
}

fn write_fixtures() {
    w_idx.set(0);

    // primitives
    w(true);
    w(false);
    w(0);
    w(42);
    w(-1);
    w(int::max);
    w(int::min);
    w(3.14);
    w(-2.5);
    w("hello");
    w("");
    w('c');

    // duration (raw `time` values format with the system timezone — leave them
    // for call-tests where we control input/output explicitly)
    w(42_us);
    w(3_s);

    // collections
    w([]);
    w([1, 2, 3]);
    w(["a", "b", "c"]);
    w([1, "two", 3.0, true]);
    w(Map<String, int> {});

    var m = Map<String, int> {};
    m.set("x", 1);
    m.set("y", 2);
    w(m);

    // custom types
    w(Person { name: "Alice", age: 30, nickname: null });
    w(Person { name: "Bob", age: 7, nickname: "Bobby" });
    w(Box<int> { value: 42 });

    // enums
    w(Color::red);
    w(Color::blue);
    w(CalendarUnit::day);

    // geo
    w(geo { 49.6, 6.13 });

    // tensor
    var t = Tensor {};
    t.init(TensorType::f64, Array<int> { 3 });
    t.add(Array<int> { 0 }, 1.0);
    t.add(Array<int> { 1 }, 2.0);
    t.add(Array<int> { 2 }, 3.0);
    w(t);

    // error
    w(Error { message: "oops", stack: Array<ErrorFrame> {} });

    // null
    w(null);
}

// === Functions exercised by call tests ===

@expose
fn add(a: int, b: int): int {
    return a + b;
}

@expose
fn concat(a: String, b: String): String {
    return "${a}${b}";
}

@expose
fn echo_any(v: any?): any? {
    return v;
}

@expose
fn echo_array(a: Array<int>): Array<int> {
    return a;
}

@expose
fn make_person(name: String, age: int, nickname: String?): Person {
    return Person { name: name, age: age, nickname: nickname };
}

@expose
fn sum_array(a: Array<int>): int {
    var s = 0;
    for (_, v in a) {
        s = s + v;
    }
    return s;
}

@expose
fn boom() {
    throw "boom";
}

@expose
fn no_result() {}
